# Shopify Store & API Configuration
# Replace with the permanent myshopify.com domain (e.g. your-store.myshopify.com)
SHOPIFY_SHOP=your-store.myshopify.com

# Shopify Admin API Version (default: 2026-10)
SHOPIFY_API_VERSION=2026-10

# ------------------------------------------------------------------------------
# AUTHENTICATION MODE 1: Client Credentials Grant (Recommended for same-org apps)
# Used when the app was created inside the merchant's Shopify Organization
# (Shopify Dev Dashboard -> Apps -> Your App -> App settings -> Credentials)
# ------------------------------------------------------------------------------
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# AUTHENTICATION MODE 2: Existing Admin API Access Token
# Used if you obtained a direct Offline / Admin API Access Token (e.g., shpat_...)
# via custom app install or standard OAuth flow.
# If SHOPIFY_ACCESS_TOKEN is present, it takes priority over Client Credentials.
# ------------------------------------------------------------------------------
SHOPIFY_ACCESS_TOKEN=
